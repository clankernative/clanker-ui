{
  "schemaVersion": 1,
  "name": "pane",
  "status": "ready",
  "target": "native-html",
  "category": "layout",
  "summary": "Frames optional chrome around content with explicit scroll ownership.",
  "keywords": [
    "pane",
    "frame",
    "scroll",
    "viewport",
    "header",
    "footer"
  ],
  "agent": {
    "useWhen": "A table, editor, log, or inspector needs fixed chrome and one scroll owner.",
    "avoidWhen": "Content should extend normal page flow without a block-size boundary.",
    "composeWith": [
      "sidebar",
      "split",
      "data-table",
      "pagination"
    ]
  },
  "contract": {
    "role": "bounded-content-pane",
    "variants": [
      "content",
      "compact",
      "standard",
      "fill",
      "viewport"
    ],
    "requiredFields": [],
    "invariants": [
      "Body is required; header and footer are optional.",
      "Bounded height and body scrolling are independent options; bounded heights default to body scrolling.",
      "Neutral wrappers add no landmarks, controls, scripts, routes, or commands."
    ]
  },
  "tokens": [
    "--cui-focus",
    "--cui-pane-height-compact",
    "--cui-pane-height-standard",
    "--cui-pane-viewport-offset"
  ],
  "tokenDescriptions": [
    {
      "name": "--cui-pane-height-compact",
      "role": "sizing",
      "purpose": "Controls compact for height pane."
    },
    {
      "name": "--cui-pane-height-standard",
      "role": "sizing",
      "purpose": "Controls visual treatment for height pane."
    },
    {
      "name": "--cui-pane-viewport-offset",
      "role": "spacing",
      "purpose": "Controls offset for pane."
    }
  ],
  "dependencies": [],
  "assets": {
    "template": "components/pane/fragment.html",
    "styles": "components/pane/styles.css",
    "scripts": []
  },
  "fixtures": [
    "components/pane/fixtures/content.json",
    "components/pane/fixtures/compact.json",
    "components/pane/fixtures/standard.json",
    "components/pane/fixtures/fill.json",
    "components/pane/fixtures/viewport.json",
    "components/pane/fixtures/content-scroll.json",
    "components/pane/fixtures/bounded-no-scroll.json"
  ]
}
